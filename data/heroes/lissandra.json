  "gameplay": {
    "status": "reviewed",
    "locked": true,
    "source": "https://aramgg.com/zh-CN/champion-stats/127",
    "summary": [
      "用Q穿过前排消耗后排，E从侧面进场并接W禁锢，尽量让技能覆盖多人。",
      "R可定住敌方核心，也可对自己施放规避集火并等待队友跟进。",
      "击杀后围绕被动冰奴继续追击；没有队友跟伤害时不要单独E进敌阵。"
    ]
  },
