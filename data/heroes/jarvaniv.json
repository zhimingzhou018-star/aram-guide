  "gameplay": {
    "status": "reviewed",
    "locked": true,
    "source": "https://aramgg.com/zh-CN/champion-stats/59",
    "summary": [
      "先用E提供攻速并配合Q击飞，队友距离不足时保留位移不要独自开团。",
      "坦克流进场后用W减速并吸收伤害，围绕旗子和地形持续限制走位。",
      "R优先困住无位移核心，也可分割前后排；注意给己方队友保留进出空间。"
    ]
  },
