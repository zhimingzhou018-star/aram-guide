  "gameplay": {
    "status": "reviewed",
    "locked": true,
    "source": "https://aramgg.com/zh-CN/champion-stats/76",
    "summary": [
      "人形态用Q远距离消耗，W陷阱标记目标后再寻找豹形态跳跃的进场窗口。",
      "命中标记后切豹形态用W贴近，接E和Q斩杀；技能落空就保持人形态继续拉扯。",
      "E优先治疗低血量核心并提供攻速，法术流不要长时间站在前排近身换血。"
    ]
  },
