  "gameplay": {
    "status": "reviewed",
    "locked": true,
    "source": "https://aramgg.com/zh-CN/champion-stats/498",
    "summary": [
      "用Q和普攻在目标身后铺羽毛，等三根以上形成角度后用E禁锢回收。",
      "围绕己方前排反向拉扯，让敌方追击路线主动穿过地面羽毛。",
      "R优先规避关键控制或爆发，落地后立即调整位置再用E完成反打。"
    ]
  },
