  "gameplay": {
    "status": "reviewed",
    "locked": true,
    "source": "https://aramgg.com/zh-CN/champion-stats/950",
    "summary": [
      "先用Q连续命中同一目标触发流血与爆发，利用犬群持续压低脆皮血线。",
      "等敌方关键控制交出后再用W锁定进场，落地接E调整位置并补范围伤害。",
      "战士流仍需选择孤立或残血目标；敌方抱团时先消耗，不要正面硬冲。"
    ]
