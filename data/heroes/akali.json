  "gameplay": {
    "status": "reviewed",
    "locked": true,
    "source": "https://aramgg.com/zh-CN/champion-stats/84",
    "summary": [
      "Q命中后拉出被动圆环，再回身打强化普攻，坦克流靠多轮被动持续换血。",
      "W烟幕留作规避集火和等待能量，E标记命中后根据敌方控制决定是否二段跟进。",
      "R第一段用于切入，第二段留给斩杀或撤退；不要在烟幕和E都空时强行进场。"
    ]
  },
