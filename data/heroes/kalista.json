  "gameplay": {
    "status": "reviewed",
    "locked": true,
    "source": "https://aramgg.com/zh-CN/champion-stats/429",
    "summary": [
      "利用被动跳跃持续调整身位，优先攻击能稳定叠矛的前排目标。",
      "E在多层长矛或目标即将脱离时拔矛，击杀单位刷新可继续维持追击节奏。",
      "R既能救回契约队友也能提供开团，敌方控制密集时不要盲目向前跳。"
    ]
  },
