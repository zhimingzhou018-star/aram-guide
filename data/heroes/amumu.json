  "gameplay": {
    "status": "reviewed",
    "locked": true,
    "source": "https://aramgg.com/zh-CN/champion-stats/32",
    "summary": [
      "优先等队友能跟进时用Q或雪球入场，开启W后贴住多人持续输出。",
      "R尽量覆盖敌方核心与前排，随后用E持续减伤并补范围伤害。",
      "第一段Q未命中时保留第二段反手，避免没有控制手段却独自走进人群。"
    ]
  },
  "sources": [
    {
