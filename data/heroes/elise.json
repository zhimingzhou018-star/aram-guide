  "gameplay": {
    "status": "reviewed",
    "locked": true,
    "source": "https://aramgg.com/zh-CN/champion-stats/60",
    "summary": [
      "人形态先用E命中关键目标，再接W和Q爆发，随后切蜘蛛形态继续追击。",
      "蜘蛛形态Q贴近后用W补输出，E升空可躲关键技能、等待冷却或选择安全落点。",
      "控制未命中时先拉开，不要只靠蜘蛛形态冲入多人；优先抓孤立脆皮。"
    ]
  },
