  "gameplay": {
    "status": "reviewed",
    "locked": true,
    "source": "https://aramgg.com/zh-CN/champion-stats/711",
    "summary": [
      "用E接Q远程消耗并积累恐惧，敌方突进时保留带恐惧的W完成反打。",
      "R只命中有把握击杀且队友能跟进的目标，击杀刷新后再决定是否继续追击。",
      "恐惧进入空窗时保持后排站位，不要为了标记伤害主动走进近战范围。"
    ]
  },
