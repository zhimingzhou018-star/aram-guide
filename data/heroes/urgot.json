  "gameplay": {
    "status": "reviewed",
    "locked": true,
    "source": "https://aramgg.com/zh-CN/champion-stats/6",
    "summary": [
      "用Q减速后接E背回目标，开启W绕着敌人移动，依次触发各方向被动腿炮。",
      "战士流优先处理能安全贴住的前排，E护盾用于挡爆发并打断关键技能。",
      "R在目标进入斩杀线后释放，命中再二段拖回；进场前确认不会被控制打断处决。"
    ]
  },
